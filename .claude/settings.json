{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/valen/.local/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/valen/.local/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "touch \"$CLAUDE_PROJECT_DIR/graphify-out/.claude_needs_update\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && if [ -f graphify-out/.claude_needs_update ]; then rm -f graphify-out/.claude_needs_update; C:/Users/valen/.local/bin/graphify.EXE update . >/dev/null 2>&1; fi; true",
            "timeout": 120,
            "statusMessage": "Updating graphify knowledge graph..."
          }
        ]
      }
    ]
  }
}