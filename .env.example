# DB 1: SPARTA master stores (read-only, owned by sparta-energy)
SPARTA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable"

# DB 2: IoT telemetry (read-only, owned by smart-energy-meter-vps)
TELEMETRY_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable"
# Fallback for TELEMETRY_DATABASE_URL; also used by Prisma tooling
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable"

# Shared Auth & SSO
BETTER_AUTH_SECRET="your-shared-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3001"

# Ecosystem & External URLs
NEXT_PUBLIC_REALTIME_METER_URL="https://energy-meter.sparta-alfamart.web.id/"
NEXT_PUBLIC_SPARTA_AUDIT_URL="http://localhost:3000"

# IoT Telemetry Engine
NEXT_PUBLIC_TELEMETRY_API_URL="http://HOST:5000/api"
NEXT_PUBLIC_TELEMETRY_WS_URL="ws://HOST:5000/ws"

# AI Strategic Analytics (Google Gemini API)
GOOGLE_GENAI_API_KEY="your-google-genai-api-key"

# Access control (shared with sparta-energy)
# Token sparta sends as x-internal-token for GET /api/stores and /api/internal/devices.
# While empty, GET /api/stores stays open without a session.
MONITORING_INTERNAL_TOKEN=""
# Dev only: devices a simulated GS user (cookie dev_role=GS) may see, comma separated devices.id
DEV_GS_DEVICE_IDS=""
